<?xml version="1.0"?>
<robot name="BlueROV2">
  <!-- Maillage Collada upstream; conserver le DAE dans ce meme dossier. -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="BlueRov2.dae"/></geometry>
    </visual>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="11"/>
      <inertia ixx="1" ixy="0" ixz="0" iyy="1" iyz="0" izz="1"/>
    </inertial>
  </link>
  <link name="camera_link"/>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0 0.21 -0.067" rpy="3.141592653589793 0 1.570796326794897"/>
    <axis xyz="1 0 0"/>
  </joint>
</robot>
